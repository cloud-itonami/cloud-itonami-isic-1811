{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates.
 ;;
 ;; FIX (deferred-stub bug, matches the isic-0115/isic-869 history): a
 ;; prior attempt at this repo pinned `io.github.com-junkawasaki/langgraph-clj`
 ;; via a stale `:git/sha` coordinate to the pre-rename repo, never wired
 ;; `langgraph.graph` into a `printing.operation` (which didn't exist), and
 ;; `printing.sim` was a one-line `(println ...)` stub that never called
 ;; the advisor/governor/store at all. `langgraph` and `langchain-store`
 ;; (the shared store seam -- EDN-blob codec + identity schema + event-log
 ;; helpers, ADR-2607141600) now live in the real :deps map, same shape as
 ;; cloud-itonami-isic-0115 (tobaccoops) / cloud-itonami-isic-869
 ;; (transportops).
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics {:local/root "../../kotoba-lang/robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        ;; Paper prepress craft engine (せいはん / CMYK+spot/bleed/trap).
        ;; Pure .cljc. NOT garment white-underbase (that is shirohan).
        ;; Monorepo: sibling under orgs/cloud-itonami/. Standalone fork:
        ;;   io.github.cloud-itonami/seihan
        ;;   {:git/url "https://github.com/cloud-itonami/seihan"
        ;;    :git/sha "b022bd26c398e148187bd0ba8f9944b65afa081f"}
        io.github.cloud-itonami/seihan
        {:local/root "../seihan"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  ;; test/ is left out here: printing.prepress requires seihan.core, which is
  ;; .kotoba (cloud-itonami/seihan src/seihan/core.kotoba) and kbb's runner
  ;; cannot load it ("Could not find namespace: seihan.core"). The repo's own
  ;; :test still runs test/ on the JVM gate.
  :physai-test {:extra-paths ["test-physai"] :main-opts ["-m" "cognitect.test-runner"]}
;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "printing.sim"]}
  :render-html {:main-opts ["-m" "printing.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
